# .env.example — no commitear el .env real
OTEL_SERVICE_NAME=mi-agente-python
OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.1.10:4320
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_HEADERS="authorization=Basic <base64(usuario:contraseña)>"
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_PROPAGATORS=tracecontext,baggage
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
